      "name": "Generate PKCE key pair",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "82a41901-e86a-4527-a856-009e1e4a243f",
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "id": "9642d06d-2064-499c-b1a3-1dd189d6e4ef",
            "exec": [
              "// Generate a cryptographically random code_verifier (43-128 chars)",
              "const charset = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';",
              "let verifier = '';",
              "for (let i = 0; i < 43; i++) {",
              "    verifier += charset.charAt(Math.floor(Math.random() * charset.length));",
              "}",
              "",
              "// Compute SHA-256 hash",
              "const hash = CryptoJS.SHA256(verifier);",
              "",
              "// Base64-URL encode the hash without padding to produce code_challenge",
              "let challenge = CryptoJS.enc.Base64.stringify(hash)",
              "    .replace(/\\+/g, '-')",
              "    .replace(/\\//g, '_')",
              "    .replace(/=+$/, '');",
              "",
              "// Save to collection variables",
              "pm.environment.set(\"pkce_code_verifier\", verifier);",
              "pm.environment.set(\"pkce_code_challenge\", challenge);",
              "",
              "console.log(\"Verifier generated:\", verifier);",
              "console.log(\"Challenge generated:\", challenge);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
