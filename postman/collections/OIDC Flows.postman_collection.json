    {
      "name": "Sign Up",
      "item": [
        {
          "name": "Initiate",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "82a41901-e86a-4527-a856-009e1e4a243f",
                "exec": [
                  "var jsonData = JSON.parse(responseBody);",
                  "",
                  "if(pm.response.code == 403)",
                  "{",
                  "    pm.environment.set(\"e_auth_session\", jsonData.auth_session);",
                  "}",
                  "",
                  "",
                  "// Tests",
                  "",
                  "pm.test(\"Status code is 403.\", () => {",
                  "  pm.expect(pm.response.code).to.eql(403);",
                  "});",
                  "",
                  "pm.test(\"Response contains an access token\", function () {",
                  "    pm.expect(jsonData).to.have.any.keys('access_token');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "id": "631670fd-d6a1-4720-8203-24f9af8ea984",
