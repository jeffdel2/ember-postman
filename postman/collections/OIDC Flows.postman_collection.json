          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "User-Agent",
                "value": "TestingNewAgent/1.2.3",
                "type": "text",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"client_id\": \"{{co_client_id}}\",\n    \"code_challenge\": \"{{pkce_code_challenge}}\",\n    \"code_challenge_method\": \"S256\",\n    \"connection\": \"{{db_connection}}\",\n    \"capabilities\": [\n      \"action:signup:v1\",\n      \"action:identify:email:v1\",\n      \"action:challenge:email:v1\",\n      \"action:verify:otp:v1\",\n      \"action:enroll:password:v1\",\n      \"action:signup:confirm:v1\"\n    ],\n    \"scope\": \"openid profile email offline_access read:me:authentication_methods create:me:authentication_methods read:me:factors\",\n    \"audience\": \"https://{{auth0_domain}}/me/\"\n  }\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://{{auth0_domain}}/e/authorize",
              "protocol": "https",
              "host": [
                "{{auth0_domain}}"
              ],
              "path": [
                "e",
                "authorize"
              ]
            },
            "description": "This is the OAuth 2.0 grant that highly trusted apps utilize in order to access an API. In this flow the end-user is asked to fill in credentials (username/password) typically using an interactive form. This information is later on sent to the Client and the Authorization Server. It is therefore imperative that the Client is absolutely trusted with this information.\nWith this extension to the basic Resource Owner Password flow you can provide a `realm` value indicating the connection to use."
          },
          "response": []
        },
